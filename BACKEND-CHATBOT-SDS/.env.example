MONGO_URI=mongodb://localhost:27017/sentiment_app
JWT_SECRET_KEY=your-secret-key-change-in-production

# Optional LLM configuration for sentiment analysis
# Priority: OPENAI_API_KEY > OPENROUTER_API_KEY
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-3.5-turbo
#
# If you do not have an OpenAI key, you can use OpenRouter instead:
# OPENROUTER_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1      # correct endpoint
# OPENROUTER_MODEL=openai/gpt-oss-20b:free